# esp_hosted's manifest tests these options to add its USB-transport dependencies, but no Kconfig
# defines them on this setup, which stops the build ("Missing required kconfig option after retry").
# Wi-Fi here goes over SDIO, so they are 0 (the manifest compares them with 1).
config ESP_HOSTED_HOST_USB_CDC_ACM_MANIFEST
    int "Not used (Wi-Fi goes over SDIO)"
    default 0
config ESP_HOSTED_HOST_USB_CHERRYUSB_MANIFEST
    int "Not used (Wi-Fi goes over SDIO)"
    default 0
config ESP_HOSTED_HOST_USB_RNDIS_MANIFEST
    int "Not used (Wi-Fi goes over SDIO)"
    default 0

# components/tab5_board (from RetroESP's Tab5 port) builds only for the Tab5 and reads these.
config BOARD_M5STACK_TAB5
    bool
    default y
config TAB5_DOUBLE_BUFFER
    bool "Tab5: double-buffered, tear-free display"
    default y
config TAB5_ROTATE_180
    bool "Tab5: turn the picture and touch by 180 degrees"
    default y
    help
        On is the right way up for RetroESP on Lab's Tab5; this firmware uses the same setting.
