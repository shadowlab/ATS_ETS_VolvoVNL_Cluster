CONFIG_IDF_TARGET="esp32p4"
# The Tab5's P4 is pre-v3 silicon
CONFIG_ESP32P4_SELECTS_REV_LESS_V3=y
CONFIG_ESP32P4_REV_MIN_1=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_360=y
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_FREERTOS_HZ=1000

# PSRAM
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_HEX=y
CONFIG_SPIRAM_SPEED_200M=y
CONFIG_SPIRAM_USE_CAPS_ALLOC=y
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y

# Console on the USB-C port (USB Serial/JTAG); the setup command comes in this way
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y

# Camera: SC202CS (the Tab5's SC2356) on MIPI-CSI. No ISP pipeline controller, so nothing
# adjusts exposure, gain or white balance on its own: the firmware sets them once and holds them.
CONFIG_IDF_EXPERIMENTAL_FEATURES=y
CONFIG_CAMERA_SC202CS=y
CONFIG_CAMERA_SC202CS_MIPI_RAW8_1280X720_30FPS=y
CONFIG_CAM_CTRL_SPI_ENABLE=n
CONFIG_ESP_VIDEO_ENABLE_ISP_PIPELINE_CONTROLLER=n

# Wi-Fi through the ESP32-C6 (ESP-Hosted 3.0.9 over SDIO, as in RetroESP's Tab5 launcher).
# The board preset has the Tab5's SDIO pins; the C6 is powered by main.c before ESP-Hosted starts.
CONFIG_ESP32P4_TAB5_C6_BOARD=y
# CONFIG_ESP_HOSTED_AUTO_CALL_INIT_BEFORE_APP_MAIN is not set
CONFIG_ESP_HOSTED_HOST_SDIO_CLK_KHZ=40000
CONFIG_WIFI_RMT_NVS_ENABLED=n

# Web server: two long-lived streams (events, video) plus requests
CONFIG_HTTPD_MAX_REQ_HDR_LEN=1024
CONFIG_HTTPD_WS_SUPPORT=n
CONFIG_LWIP_MAX_SOCKETS=16
CONFIG_ESP_TASK_WDT_TIMEOUT_S=10
